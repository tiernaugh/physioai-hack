# local = local audio upload and Whisper transcription. AI analysis is configured separately.
# live = same local processing, plus the official WhatsApp Cloud API webhook.
# demo = original fixed fixture, requiring no downloaded model.
VOICE_MODE=local
VOICE_PORT=3001
WHISPER_MODEL_PATH=models/ggml-base.en.bin
WHISPER_BIN=whisper-cli
WHISPER_LANGUAGE=en
# Optional executable override; defaults to the bundled ffmpeg-static binary.
FFMPEG_BIN=

# Optional contextual analysis. The server sends transcripts + selected earlier notes
# to OpenAI. No key/model is bundled into the browser. Without a key this stays off.
# Set off explicitly for fully offline transcription + the basic text parser.
VOICE_ANALYSIS_PROVIDER=off
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
# Optional store override, relative to project-app when started with npm run voice.
# VOICE_DATA_DIR=../data/voice-local

# Only required for live WhatsApp mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Graph API version enabled in your Meta app, e.g. v23.0.
WHATSAPP_API_VERSION=
WHATSAPP_PORT=3000
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PATIENT_MAP={}
# Random admin secret of at least 24 characters for live inbox access.
ADMIN_TOKEN=
